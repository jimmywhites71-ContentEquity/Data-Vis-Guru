{
  "_comment": "Single source of truth for look and feel. Swap these values for a client's brand, then run `python -m vizguru.lint --palette` to re-check colour separation. Nothing else in the toolkit hard-codes a colour or a font.",
  "font": {
    "family": ["Inter", "Helvetica Neue", "Arial", "DejaVu Sans"],
    "title_weight": "semibold",
    "sizes_pt": {
      "title": 17,
      "subtitle": 11.5,
      "label": 10,
      "tick": 9.5,
      "annotation": 9.5,
      "footer": 8.5
    }
  },
  "modes": {
    "light": {
      "surface": "#fcfcfb",
      "text_primary": "#0b0b0b",
      "text_secondary": "#52514e",
      "text_muted": "#6b6a65",
      "grid": "#e6e5e0",
      "axis": "#b9b8b1",
      "context": "#c9c8c1",
      "categorical": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
      "sequential": ["#cde2fb", "#9ec5f4", "#6da7ec", "#3987e5", "#256abf", "#184f95", "#0d366b"],
      "diverging": {
        "negative": "#d03b3b",
        "neutral": "#f0efec",
        "positive": "#2a78d6"
      },
      "status": {
        "good": "#0ca30c",
        "warning": "#fab219",
        "serious": "#ec835a",
        "critical": "#d03b3b"
      }
    },
    "dark": {
      "surface": "#1a1a19",
      "text_primary": "#f0efec",
      "text_secondary": "#c3c2b7",
      "text_muted": "#8f8e86",
      "grid": "#32322f",
      "axis": "#55544f",
      "context": "#5b5a55",
      "categorical": ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#9085e9", "#e66767"],
      "sequential": ["#0d366b", "#184f95", "#256abf", "#3987e5", "#6da7ec", "#9ec5f4", "#cde2fb"],
      "diverging": {
        "negative": "#e66767",
        "neutral": "#383835",
        "positive": "#3987e5"
      },
      "status": {
        "good": "#0ca30c",
        "warning": "#fab219",
        "serious": "#ec835a",
        "critical": "#d03b3b"
      }
    }
  },
  "presets": {
    "slide_16x9": {
      "px": [1920, 1080],
      "dpi": 150,
      "use": "PowerPoint / Keynote full-bleed slide",
      "text_scale": 1.0,
      "min_pt": 9
    },
    "slide_half": {
      "px": [1200, 1050],
      "dpi": 150,
      "use": "Half of a 16:9 slide, beside text",
      "text_scale": 0.95,
      "min_pt": 8.5
    },
    "report_full_width": {
      "px": [1950, 1100],
      "dpi": 300,
      "use": "A4 / Letter report, full text width (6.5in)",
      "text_scale": 0.75,
      "min_pt": 6.5
    },
    "report_half_width": {
      "px": [960, 840],
      "dpi": 300,
      "use": "A4 / Letter report, two-up (3.2in)",
      "text_scale": 0.68,
      "min_pt": 6
    },
    "social_square": {
      "px": [1080, 1080],
      "dpi": 150,
      "use": "LinkedIn / Instagram feed, square",
      "text_scale": 1.1,
      "min_pt": 10
    },
    "social_portrait": {
      "px": [1080, 1350],
      "dpi": 150,
      "use": "LinkedIn / Instagram feed, 4:5 portrait",
      "text_scale": 1.15,
      "min_pt": 10.5
    },
    "video_1080p": {
      "px": [1920, 1080],
      "dpi": 150,
      "use": "Landscape video, YouTube, webinar",
      "text_scale": 1.3,
      "min_pt": 12
    },
    "video_vertical": {
      "px": [1080, 1920],
      "dpi": 150,
      "use": "Reels / Shorts / Stories, 9:16",
      "text_scale": 1.4,
      "min_pt": 13
    }
  }
}
